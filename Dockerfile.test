# Lightweight test Dockerfile for building Nextcloud Android app (Generic APK)
FROM ubuntu:noble@sha256:9cbed754112939e914291337b5e554b07ad7c392491dba6daf25eef1332a22e8

ARG DEBIAN_FRONTEND=noninteractive
ENV ANDROID_HOME=/usr/lib/android-sdk

# Install required packages
RUN apt-get update -y && \
    apt-get install -y \
        unzip \
        wget \
        openjdk-17-jdk \
        git \
        && rm -rf /var/lib/apt/lists/*

# Download and install Android SDK command line tools
RUN wget https://dl.google.com/android/repository/commandlinetools-linux-6858069_latest.zip -O /tmp/commandlinetools.zip && \
    cd /tmp && unzip commandlinetools.zip && \
    mkdir -p /usr/lib/android-sdk/cmdline-tools/ && \
    mv cmdline-tools/ latest/ && \
    mv latest/ /usr/lib/android-sdk/cmdline-tools/ && \
    rm /tmp/commandlinetools.zip

# Set up Android SDK licenses and permissions
RUN mkdir -p /usr/lib/android-sdk/licenses/ && \
    chmod -R 755 /usr/lib/android-sdk/

# Set environment variables early
ENV PATH="$PATH:/usr/lib/android-sdk/platform-tools:/usr/lib/android-sdk/cmdline-tools/latest/bin"
ENV JAVA_HOME="/usr/lib/jvm/java-17-openjdk-amd64"

# Accept Android licenses - do this after PATH is set
RUN yes | sdkmanager --licenses || true

# Install required Android SDK components - minimal set first
RUN sdkmanager "platform-tools" "platforms;android-35" "build-tools;35.0.0"

# Set up Gradle properties for optimal performance
RUN mkdir -p /root/.gradle && \
    echo "org.gradle.jvmargs=-Xmx6g -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8 -XX:+UseParallelGC -XX:MaxMetaspaceSize=1g" > /root/.gradle/gradle.properties && \
    echo "org.gradle.caching=true" >> /root/.gradle/gradle.properties && \
    echo "org.gradle.parallel=true" >> /root/.gradle/gradle.properties && \
    echo "org.gradle.configureondemand=true" >> /root/.gradle/gradle.properties && \
    echo "kapt.incremental.apt=true" >> /root/.gradle/gradle.properties

# Set working directory
WORKDIR /workspace

# Copy the source code
COPY . .

# Make gradlew executable
RUN chmod +x ./gradlew

# Test configuration first
RUN ./gradlew --version

# Test if assembleGeneric task is available
RUN ./gradlew tasks | grep assembleGeneric

# Default command
CMD ["echo", "Docker image built successfully. Run './gradlew assembleGeneric' to build the APK."]